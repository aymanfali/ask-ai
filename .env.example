# Application
APP_NAME=Ask AI
APP_ENV=local
APP_DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Local Docker Compose credentials only. Replace outside local development.
POSTGRES_PASSWORD=ask_ai_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Local host-run backend URLs. Docker Compose overrides hosts to service names.
DATABASE_URL=postgresql+asyncpg://ask_ai:ask_ai_local_only@localhost:5432/ask_ai
REDIS_URL=redis://localhost:6379/0

# Connection pools and timeouts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
HEALTH_CHECK_TIMEOUT_SECONDS=2

# JSON array required by pydantic-settings for this complex setting.
CORS_ORIGINS=["http://localhost:5173"]

# SECRET_KEY is intentionally not required until the authentication milestone.
# Add a unique random value then; never commit a real secret.

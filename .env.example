# Application
APP_NAME=Ask AI
APP_ENV=local
APP_DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Local Docker Compose credentials only. Replace outside local development.
POSTGRES_PASSWORD=ask_ai_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Local host-run backend URLs. Docker Compose overrides hosts to service names.
DATABASE_URL=postgresql+asyncpg://ask_ai:ask_ai_local_only@localhost:5432/ask_ai
REDIS_URL=redis://localhost:6379/0

# Connection pools and timeouts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
HEALTH_CHECK_TIMEOUT_SECONDS=2

# JSON array required by pydantic-settings for this complex setting.
CORS_ORIGINS=["http://localhost:5173"]

# Authentication. Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The local default is deliberately non-production. Set a unique value in staging/production.
SECRET_KEY=ask-ai-local-development-secret-change-me-please-123456789
JWT_ISSUER=ask-ai
JWT_AUDIENCE=ask-ai-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_SESSION_ABSOLUTE_TTL_DAYS=90
AUTH_ALLOW_REGISTRATION=true
AUTH_REFRESH_COOKIE_NAME=ask_ai_refresh
AUTH_CSRF_COOKIE_NAME=ask_ai_csrf
AUTH_SESSION_COOKIE_NAME=ask_ai_oauth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_OAUTH_SESSION_TTL_SECONDS=600
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Optional Google OpenID Connect. Register the callback URL below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Optional Apple Sign In. APPLE_CLIENT_SECRET must be a signed developer JWT generated
# from your Apple Team ID, Services ID, Key ID, and private key; rotate before expiration.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# LLM provider credentials stay on the server and are never returned by the API.
# Configure providers as JSON. Supported adapter types: openai_compatible, anthropic.
# Example (replace credentials and endpoint with values from your provider):
# LLM_PROVIDERS=[{"id":"openai","name":"OpenAI","type":"openai_compatible","api_key":"replace-me","base_url":"https://api.openai.com/v1","max_output_tokens_parameter":"max_completion_tokens"},{"id":"anthropic","name":"Anthropic","type":"anthropic","api_key":"replace-me"}]
# Model IDs are application-owned stable identifiers; provider_model_id must be the
# exact upstream model ID available to your account. Do not copy context/pricing values
# from examples; verify each model's official limits and pricing before configuring it.
# LLM_MODELS=[{"id":"openai:my-model","provider_id":"openai","provider_model_id":"YOUR_OPENAI_MODEL_ID","name":"My OpenAI Model","context_window":128000,"max_output_tokens":8192,"capabilities":{"streaming":true,"tools":false,"structured_output":false,"vision":false,"reasoning":false},"pricing":[]},{"id":"anthropic:my-model","provider_id":"anthropic","provider_model_id":"YOUR_ANTHROPIC_MODEL_ID","name":"My Anthropic Model","context_window":200000,"max_output_tokens":8192,"capabilities":{"streaming":true,"tools":false,"structured_output":false,"vision":false,"reasoning":false},"pricing":[]}]

# Generation orchestration policy
GENERATION_DEFAULT_MAX_OUTPUT_TOKENS=1024
GENERATION_HISTORY_MAX_MESSAGES=100
GENERATION_CONTEXT_SAFETY_FACTOR=0.85
GENERATION_MAX_RETRIES=1
GENERATION_RETRY_BASE_SECONDS=0.5
GENERATION_MAX_DURATION_SECONDS=180
GENERATION_PARTIAL_FLUSH_CHARACTERS=4096
GENERATION_CANCEL_SIGNAL_TTL_SECONDS=300
# Optional operator-controlled system instruction. Keep this short and non-secret.
# GENERATION_SYSTEM_PROMPT=You are Ask AI, a helpful assistant.
